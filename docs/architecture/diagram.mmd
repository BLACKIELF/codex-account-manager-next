%% 这是 README/GitHub 自渲染的 fallback view。改架构改 schema.yaml，本块同步抄过来。
%% 预览: 整块粘到 https://mermaid.live，或 VS Code 装 Markdown Preview Mermaid Support。
flowchart TB
    %% ── Nodes ──
    codex_app_server["Codex app-server<br/>(account/read · rateLimits/read · usage/read)<br/>额度、账户、云端 lifetime tokens"]:::external
    codex_sqlite[("~/.codex/state_5.sqlite<br/>(本地 SQLite)<br/>线程元数据、rollout 路径")]:::external
    codex_jsonl[("~/.codex/sessions/*.jsonl<br/>(token_count / task_started / task_complete)<br/>细粒度 token 事件")]:::external
    codex_automation[/"~/.codex/automations<br/>(automation.toml)<br/>定时任务元数据"/]:::external
    claude_transcript[("~/.claude/projects/*.jsonl<br/>(message.usage · tool_use · attribution)<br/>Claude Code transcript")]:::external
    claude_tasks[/"~/.claude/tasks/*.json<br/>(task status / subject)<br/>Claude Code 任务"/]:::external
    claude_statusline[/"statusline-snapshot.json<br/>(~/Library/Caches/codexU/...)<br/>Claude Code 活跃额度快照"/]:::external
    github_releases["GitHub Releases API<br/>(shanggqm/codexU)<br/>版本检查与更新元数据"]:::external

    codex_provider["CodexRuntimeProvider<br/>(RuntimeUsageProvider)<br/>读取 SQLite + JSONL + automations"]:::runtime
    claude_provider["ClaudeCodeRuntimeProvider<br/>(RuntimeUsageProvider)<br/>读取 transcript + tasks + statusLine"]:::runtime
    provider_registry["RuntimeProviderRegistry<br/>(注册表)<br/>聚合 Codex / Claude Code"]:::runtime

    multi_reader["MultiRuntimeUsageReader<br/>(load() · loadTaskBoard())<br/>统一入口；PerformanceMonitor 测时"]:::core
    aggregator["AgentUsageAggregator<br/>(aggregate(runtimes))<br/>跨 runtime 合并用量与任务"]:::core
    leadership_reader["LeadershipDataReader<br/>(load(context))<br/>文件指纹缓存；增量解析 34 天数据"]:::core
    leadership_model["LeadershipScoreModel v1.3<br/>(四维加权几何平均)<br/>span · leverage · orchestration · autonomy"]:::core
    task_runtime["TaskRuntime<br/>(Codex / Claude 任务状态归一)<br/>active / pending / scheduled / done"]:::core
    quota_continuity["RuntimeQuotaContinuity<br/>(reconcile(previous, incoming))<br/>配额失败时复用旧值，防闪烁"]:::core

    design_system["DesignSystem / Palettes<br/>(青花瓷 · 故宫红 · 敦煌飞天 · 兰亭晨曦)<br/>Liquid Glass 风格；受控配色 token"]:::config
    swiftui_views["SwiftUI Views<br/>(LeadershipViews · RuntimeViews)<br/>主窗口仪表盘"]:::front
    menu_bar["Menu Bar Extra<br/>(NSStatusItem)<br/>实时额度环、今日 token、Runtime 菜单"]:::front

    self_tests["Self Tests<br/>(--self-test-*)<br/>模型趋势、领导力、性能、粒子动画等"]:::infra
    makefile["Makefile / scripts<br/>(make build · probe · release)<br/>构建、打包、内存风险门禁"]:::infra
    agent_skills["Agent Skills<br/>(.agents/skills/)<br/>PR review · release 等项目级 Skill"]:::infra

    %% ── Edges ──
    codex_app_server -- "额度 / 账户" --> codex_provider
    codex_sqlite -- "线程元数据" --> codex_provider
    codex_jsonl -- "token 事件" --> codex_provider
    codex_automation -- "定时任务" --> codex_provider
    claude_transcript -- "usage / tools" --> claude_provider
    claude_tasks -- "任务状态" --> claude_provider
    claude_statusline -- "额度快照" --> claude_provider
    codex_provider --> provider_registry
    claude_provider --> provider_registry
    provider_registry --> multi_reader
    multi_reader -- "合并多 runtime" --> aggregator
    multi_reader -- "34 天数据" --> leadership_reader
    leadership_reader -- "workers + intervals" --> leadership_model
    leadership_model -- "AI 领导力报告" --> swiftui_views
    aggregator -- "聚合用量 / 任务" --> swiftui_views
    codex_provider --> task_runtime
    claude_provider --> task_runtime
    task_runtime -- "统一任务板" --> swiftui_views
    quota_continuity -. "防闪烁" .-> multi_reader
    design_system --> swiftui_views
    design_system --> menu_bar
    aggregator -- "状态栏摘要" --> menu_bar
    github_releases -- "版本检查" --> makefile
    self_tests --> makefile
    agent_skills --> makefile

    %% ── ClassDef ──
    classDef external fill:#dbeafe,stroke:#3b82f6,color:#000
    classDef runtime fill:#fce7f3,stroke:#ec4899,color:#000
    classDef core fill:#d1fae5,stroke:#10b981,color:#000
    classDef front fill:#e0e7ff,stroke:#6366f1,color:#000
    classDef config fill:#fef3c7,stroke:#f59e0b,color:#000
    classDef infra fill:#f3f4f6,stroke:#6b7280,color:#000
